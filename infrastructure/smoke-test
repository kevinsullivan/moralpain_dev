#!/usr/bin/env bash
#
# smoke-test - Poke each deployed API endpoint with an example request.
#
# Usage:
#   ./smoke-test                                    # auto-detects the API URL, signs all
#   ./smoke-test https://xxx.execute-api.us-east-1.amazonaws.com/v1
#   ./smoke-test --unsigned                         # skip signing (expect 403 on every endpoint)
#
# All endpoints require AWS sigv4 auth. awscurl signs every request with
# your current AWS credentials. `--unsigned` skips signing, which is useful
# for confirming that auth is actually being enforced (expect 403s).
#
# Requires:  pip install --user awscurl

set -euo pipefail

cd "$(dirname "$0")"

SIGN=1
API_URL=""
for arg in "$@"; do
    case "$arg" in
        --unsigned) SIGN=0 ;;
        -h|--help)
            sed -n '3,15p' "$0" | sed 's/^# //; s/^#$//'
            exit 0
            ;;
        https://*) API_URL="$arg" ;;
        *)
            echo "Unknown argument: $arg" >&2
            exit 2
            ;;
    esac
done

if [ -z "$API_URL" ]; then
    base=$(aws cloudformation describe-stacks --stack-name moralpain-api \
        --query 'Stacks[0].Outputs[?OutputKey==`APIUri`].OutputValue' \
        --output text 2>/dev/null)
    if [ -z "$base" ] || [ "$base" = "None" ]; then
        echo "Could not auto-detect API URL from stack 'moralpain-api'." >&2
        echo "Pass it as an argument (with /v1 suffix)." >&2
        exit 1
    fi
    API_URL="$base/v1"
fi

if [ "$SIGN" = "1" ] && ! command -v awscurl >/dev/null 2>&1; then
    echo "awscurl not installed. Run: pip install --user awscurl" >&2
    echo "Or re-run with --unsigned to hit the API without auth." >&2
    exit 1
fi

request() {
    local method="$1" path="$2" body="${3:-}"
    if [ "$SIGN" = "1" ]; then
        if [ -n "$body" ]; then
            awscurl -X "$method" --service execute-api \
                -H 'Content-Type: application/json' \
                -d "$body" "$API_URL$path"
        else
            awscurl -X "$method" --service execute-api "$API_URL$path"
        fi
        echo
    else
        if [ -n "$body" ]; then
            curl -sS -w '\n-> HTTP %{http_code}\n' -X "$method" \
                -H 'Content-Type: application/json' \
                -d "$body" "$API_URL$path"
        else
            curl -sS -w '\n-> HTTP %{http_code}\n' -X "$method" "$API_URL$path"
        fi
    fi
}

echo ">>> Using API base URL: $API_URL"
if [ "$SIGN" = "1" ]; then
    echo ">>> Signing all requests with sigv4 (awscurl)."
else
    echo ">>> Sending all requests UNSIGNED (--unsigned)."
fi
TS=$(date +%s)

section() { echo; echo "========== $* =========="; }

section "GET /survey"
request GET /survey

section "POST /survey"
request POST /survey "{\"id\":\"smoke-test-$TS\",\"score\":42,\"selections\":[\"fearing_litigation\"],\"timestamp\":$TS}"

section "GET /resiliency"
request GET /resiliency

section "POST /resiliency"
request POST /resiliency "{\"selections\":[\"001\",\"002\"],\"timestamp\":$TS}"

echo
echo ">>> Smoke test complete."
