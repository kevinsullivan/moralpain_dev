#!/usr/bin/env bash
#
# smoke-test - Exercise every deployed API endpoint end-to-end.
#
# Usage:
#   ./smoke-test                                    # auto-detects the API URL
#   ./smoke-test https://xxx.execute-api.us-east-1.amazonaws.com/v1
#
# For every endpoint this script:
#   - Sends the request UNSIGNED and asserts API Gateway rejects it
#     with HTTP 403 (confirms sigv4 is actually being enforced).
#   - Sends the request SIGNED with your AWS credentials and
#     asserts HTTP 200.
#
# For the two POST endpoints it additionally:
#   - Counts objects under the target S3 prefix before and after the
#     signed POST and asserts the count went up by exactly one.
#   - WARNS that the count check is racy if other clients are writing
#     to the bucket concurrently.
#
# Signing uses curl's native --aws-sigv4 (curl 7.75+). AWS credentials
# are sourced from the usual locations: env vars, ~/.aws/credentials,
# or SSO cache. If AWS_SESSION_TOKEN is set, it's passed through with
# x-amz-security-token.

set -euo pipefail

cd "$(dirname "$0")"

API_URL=""
for arg in "$@"; do
    case "$arg" in
        -h|--help)
            sed -n '3,22p' "$0" | sed 's/^# //; s/^#$//'
            exit 0
            ;;
        https://*) API_URL="$arg" ;;
        *)
            echo "Unknown argument: $arg" >&2
            exit 2
            ;;
    esac
done

if [ -z "$API_URL" ]; then
    base=$(aws cloudformation describe-stacks --stack-name moralpain-api \
        --query 'Stacks[0].Outputs[?OutputKey==`APIUri`].OutputValue' \
        --output text 2>/dev/null)
    if [ -z "$base" ] || [ "$base" = "None" ]; then
        echo "Could not auto-detect API URL from stack 'moralpain-api'." >&2
        echo "Pass it as an argument (with /v1 suffix)." >&2
        exit 1
    fi
    API_URL="$base/v1"
fi

# Resolve AWS credentials once. We ask the AWS CLI for the effective
# credentials so SSO profiles, env vars, and static keys all work.
eval "$(aws configure export-credentials --format env 2>/dev/null)" || {
    echo "Could not load AWS credentials via 'aws configure export-credentials'." >&2
    echo "Make sure your session is active (e.g. 'aws sso login')." >&2
    exit 1
}
if [ -z "${AWS_ACCESS_KEY_ID:-}" ] || [ -z "${AWS_SECRET_ACCESS_KEY:-}" ]; then
    echo "AWS credentials not found after export. Aborting." >&2
    exit 1
fi
REGION=$(aws configure get region 2>/dev/null || echo us-east-1)

SUBMISSIONS_BUCKET="moralpain-submissions-26"
TS=$(date +%s)

PASS=0
FAIL=0

pass() { echo "  PASS: $1"; PASS=$((PASS+1)); }
fail() { echo "  FAIL: $1"; FAIL=$((FAIL+1)); }
section() { echo; echo "========== $* =========="; }

# Count objects under an S3 prefix.
s3_count() {
    aws s3api list-objects-v2 --bucket "$1" --prefix "$2" \
        --query 'length(Contents || `[]`)' --output text 2>/dev/null
}

# Emit a race-condition warning about object counts on a shared bucket.
race_warning() {
    echo "  NOTE: pre/post count check assumes no other clients are"
    echo "        writing to s3://$SUBMISSIONS_BUCKET/$1 right now."
    echo "        If they are, this assertion is unreliable."
}

# HTTP status of an unsigned request. Expects 403.
assert_unsigned_rejected() {
    local method="$1" path="$2" body="${3:-}"
    local args=(-sS -o /dev/null -w '%{http_code}' -X "$method" "$API_URL$path")
    if [ -n "$body" ]; then
        args=(-H 'Content-Type: application/json' -d "$body" "${args[@]}")
    fi
    local code
    code=$(curl "${args[@]}")
    if [ "$code" = "403" ]; then
        pass "unsigned $method $path -> 403 (auth enforced)"
    else
        fail "unsigned $method $path -> $code (expected 403)"
    fi
}

# HTTP status and body of a signed (curl --aws-sigv4) request. Expects 200.
# Sets $RESPONSE_BODY on success.
RESPONSE_BODY=""
assert_signed_ok() {
    local method="$1" path="$2" body="${3:-}"
    local tmp
    tmp=$(mktemp)
    local args=(
        -sS
        --aws-sigv4 "aws:amz:$REGION:execute-api"
        --user "$AWS_ACCESS_KEY_ID:$AWS_SECRET_ACCESS_KEY"
        -o "$tmp"
        -w '%{http_code}'
        -X "$method"
    )
    if [ -n "${AWS_SESSION_TOKEN:-}" ]; then
        args+=(-H "x-amz-security-token: $AWS_SESSION_TOKEN")
    fi
    if [ -n "$body" ]; then
        args+=(-H 'Content-Type: application/json' -d "$body")
    fi
    args+=("$API_URL$path")

    local code
    code=$(curl "${args[@]}")
    RESPONSE_BODY=$(cat "$tmp")
    rm -f "$tmp"
    if [ "$code" = "200" ]; then
        pass "signed $method $path -> 200"
        return 0
    else
        fail "signed $method $path -> $code"
        echo "$RESPONSE_BODY" | head -5 | sed 's/^/    /'
        return 1
    fi
}

echo ">>> Using API base URL: $API_URL"
echo ">>> Submissions bucket: s3://$SUBMISSIONS_BUCKET"

section "GET /survey"
assert_unsigned_rejected GET /survey
assert_signed_ok          GET /survey

section "GET /resiliency"
assert_unsigned_rejected GET /resiliency
assert_signed_ok          GET /resiliency

section "POST /survey"
SURVEY_BODY="{\"id\":\"smoke-test-$TS\",\"score\":42,\"selections\":[\"fearing_litigation\"],\"timestamp\":$TS}"
assert_unsigned_rejected POST /survey "$SURVEY_BODY"
race_warning "surveys/"
before=$(s3_count "$SUBMISSIONS_BUCKET" "surveys/")
if assert_signed_ok POST /survey "$SURVEY_BODY"; then
    sleep 2  # eventual-consistency buffer
    after=$(s3_count "$SUBMISSIONS_BUCKET" "surveys/")
    if [ "$after" = "$((before + 1))" ]; then
        pass "surveys/ object count $before -> $after (+1)"
    else
        fail "surveys/ object count $before -> $after (expected +1)"
    fi
fi

section "POST /resiliency"
RES_BODY="{\"selections\":[\"001\",\"002\"],\"timestamp\":$TS}"
assert_unsigned_rejected POST /resiliency "$RES_BODY"
race_warning "resiliency/"
before=$(s3_count "$SUBMISSIONS_BUCKET" "resiliency/")
if assert_signed_ok POST /resiliency "$RES_BODY"; then
    sleep 2
    after=$(s3_count "$SUBMISSIONS_BUCKET" "resiliency/")
    if [ "$after" = "$((before + 1))" ]; then
        pass "resiliency/ object count $before -> $after (+1)"
    else
        fail "resiliency/ object count $before -> $after (expected +1)"
    fi
fi

echo
echo "========== Summary =========="
echo "  Passed: $PASS"
echo "  Failed: $FAIL"
if [ "$FAIL" -gt 0 ]; then
    exit 1
fi
