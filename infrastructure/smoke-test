#!/usr/bin/env bash
#
# smoke-test - Poke each deployed API endpoint with an example request.
#
# Usage:
#   ./smoke-test                                    # auto-detects the API URL
#   ./smoke-test https://xxx.execute-api.us-east-1.amazonaws.com/v1
#
# GET /survey and GET /resiliency are public S3 proxies and just need a
# bare curl. POST /resiliency is a Lambda with no auth. POST /survey is a
# Lambda behind sigv4, so we sign it with awscurl when available (`pip
# install awscurl`). Pass --survey-unsigned to skip signing and see the
# raw 403 from API Gateway.

set -euo pipefail

cd "$(dirname "$0")"

SIGN_SURVEY=1
API_URL=""
for arg in "$@"; do
    case "$arg" in
        --survey-unsigned) SIGN_SURVEY=0 ;;
        -h|--help)
            sed -n '3,14p' "$0" | sed 's/^# //; s/^#$//'
            exit 0
            ;;
        https://*) API_URL="$arg" ;;
        *)
            echo "Unknown argument: $arg" >&2
            exit 2
            ;;
    esac
done

if [ -z "$API_URL" ]; then
    # Read APIUri from the moralpain-api CloudFormation stack output.
    base=$(aws cloudformation describe-stacks --stack-name moralpain-api \
        --query 'Stacks[0].Outputs[?OutputKey==`APIUri`].OutputValue' \
        --output text 2>/dev/null)
    if [ -z "$base" ] || [ "$base" = "None" ]; then
        echo "Could not auto-detect API URL from stack 'moralpain-api'." >&2
        echo "Pass it as an argument (with /v1 suffix)." >&2
        exit 1
    fi
    # APIUri in the stack output is just the base; append the stage.
    API_URL="$base/v1"
fi

echo ">>> Using API base URL: $API_URL"
TS=$(date +%s)

section() { echo; echo "========== $* =========="; }

section "GET /survey (S3 proxy, public)"
curl -sS -w '\n-> HTTP %{http_code}\n' "$API_URL/survey" | head -20

section "GET /resiliency (S3 proxy, public)"
curl -sS -w '\n-> HTTP %{http_code}\n' "$API_URL/resiliency" | head -20

section "POST /resiliency (Lambda, no auth)"
curl -sS -w '\n-> HTTP %{http_code}\n' \
    -X POST -H 'Content-Type: application/json' \
    -d "{\"selections\":[\"001\",\"002\"],\"timestamp\":$TS}" \
    "$API_URL/resiliency"

section "POST /survey (Lambda, sigv4)"
body="{\"id\":\"smoke-test-$TS\",\"score\":42,\"selections\":[\"fearing_litigation\"],\"timestamp\":$TS}"
if [ "$SIGN_SURVEY" = "1" ]; then
    if ! command -v awscurl >/dev/null 2>&1; then
        echo "awscurl not installed. Run: pip install --user awscurl"
        echo "Or re-run with --survey-unsigned to see the 403 from API Gateway."
        exit 1
    fi
    awscurl -X POST \
        --service execute-api \
        -H 'Content-Type: application/json' \
        -d "$body" \
        "$API_URL/survey"
    echo
else
    curl -sS -w '\n-> HTTP %{http_code}\n' \
        -X POST -H 'Content-Type: application/json' \
        -d "$body" \
        "$API_URL/survey"
fi

echo
echo ">>> Smoke test complete."
